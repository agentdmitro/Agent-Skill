[
  {
    "id": "follow_up_add_language",
    "category": "follow_up",
    "description": "Turn 2 adds a language; same QID must be reused, topic must not be re-resolved from scratch.",
    "user_messages": [
      "Compare astronomy in Polish and Czech Wikipedia over the last 24 months.",
      "Add Ukrainian."
    ],
    "turns": [
      {
        "simulated_request": {
          "topic": "Astronomy",
          "query_language": "en",
          "languages": ["pl", "cs"],
          "period": {"start": "2024-01", "end": "2025-12"},
          "intent": "compare"
        },
        "fixture": {
          "qid": "Q333",
          "label": "Astronomy",
          "sitelinks": {"pl": "Astronomia", "cs": "Astronomie", "uk": "Астрономія"},
          "trend": "growing"
        },
        "expected": {
          "status": "success",
          "expected_topic_id": "Q333",
          "expected_languages": ["pl", "cs"],
          "next_state_version": 1
        }
      },
      {
        "simulated_request": {
          "topic": "Astronomy",
          "query_language": "en",
          "languages": ["pl", "cs", "uk"],
          "period": {"start": "2024-01", "end": "2025-12"},
          "intent": "compare",
          "previous_state": "turn_0"
        },
        "expected": {
          "status": "success",
          "expected_topic_id": "Q333",
          "expected_languages": ["pl", "cs", "uk"],
          "topic_reused_not_reresolved": true,
          "same_period_as_previous": true,
          "next_state_version": 2,
          "notes": "Only Ukrainian was added; pl/cs must not be re-fetched with a fresh search."
        }
      }
    ]
  },
